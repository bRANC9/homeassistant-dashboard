[
  {
    "id": "ha-dashboard-deploy",
    "execute-command": "/deploy/deploy.sh",
    "command-working-directory": "/deploy/repo",
    "trigger-rule": {
      "match": {
        "type": "value",
        "value": "push",
        "parameter": {
          "source": "header",
          "name": "X-GitHub-Event"
        }
      }
    },
    "response-message": "Deploy triggered",
    "pass-environment-to-command": [
      {
        "envname": "WEBHOOK_REF",
        "source": "header",
        "name": "X-GitHub-Event"
      },
      {
        "envname": "PAYLOAD",
        "source": "payload"
      },
      {
        "envname": "X_HUB_SIGNATURE_256",
        "source": "header",
        "name": "X-Hub-Signature-256"
      }
    ]
  }
]
