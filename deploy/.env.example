# ──────────────────────────────────────────────────────────────
# .env — Deployment konfiguráció (NEM commit-olandó!)
# ──────────────────────────────────────────────────────────────

# GitHub webhook titkos kulcs
WEBHOOK_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# HA config könyvtár — TrueNAS-on belüli elérési út
# Pl. /mnt/pool/homeassistant/config
HA_CONFIG_PATH=/mnt/pool/homeassistant/config

# HA API
HA_TOKEN=YOUR_HA_LONG_LIVED_TOKEN
HA_URL=http://localhost:8123
